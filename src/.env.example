# Copy to src/.env and fill in real values. Never commit src/.env.

# Required. Hugging Face access token with permission to call Inference
# Providers: https://huggingface.co/settings/tokens
HF_API_KEY=

# Optional. Comma-separated frontend origins allowed to call the API.
# Defaults to http://localhost:5173,http://localhost:3000
# CORS_ORIGINS=https://your-frontend.com
