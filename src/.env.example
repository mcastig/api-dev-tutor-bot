# Copy to src/.env and fill in real values. Never commit src/.env.

# Required. Hugging Face access token with permission to call Inference
# Providers: https://huggingface.co/settings/tokens
HF_API_KEY=

# Optional. Comma-separated frontend origins allowed to call the API.
# Defaults to http://localhost:5173,http://localhost:3000
# CORS_ORIGINS=https://your-frontend.com

# ---- Fine-tuning (local only, never on Render) ----

# Groq API key for scripts/generate_dataset.py (the teacher model):
# https://console.groq.com/keys
# GROQ_API_KEY=

# "1" runs the embeddings and the fine-tuned model on this machine instead of
# calling Hugging Face. Needs `uv sync --group finetuned` and a trained adapter.
# USE_FINETUNED=1

# Path or Hub repo id of the LoRA adapter. Defaults to ./models/devtutor-lora
# FINETUNED_ADAPTER=./models/devtutor-lora
